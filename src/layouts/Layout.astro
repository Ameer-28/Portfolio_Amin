---
import '../styles/global.css';
import SilkBackground from '../components/SilkBackground.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muhammad Amin Murtadho — Backend Developer",
  description = "Muhammad Amin Murtadho — Backend developer in progress. Next.js & Nest.js, siswa RPL SMK Telkom Malang.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SilkBackground />
    <slot />
  </body>
</html>