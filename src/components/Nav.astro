---
const pathname = Astro.url.pathname;
const isProjectPage = pathname.startsWith('/project');
---
<!-- Desktop & Mobile Top Header (Brand on Mobile, Full Nav on Desktop) -->
<header class="navwrap" id="mainNav">
  <div class="nav">
    <a href="/#hero" class="brand">mhmmdamn.</a>
    <nav class="links" id="navLinks">
      <a href="/#hero" data-id="hero" class={!isProjectPage ? 'active' : ''}>Home</a>
      <a href="/#about" data-id="about">About</a>
      <a href="/#projects" data-id="projects" class={isProjectPage ? 'active' : ''}>Portfolio</a>
      <a href="/#contact" data-id="contact">Contact</a>
    </nav>
  </div>
</header>

<!-- Mobile Floating Bottom Navigation (Notched Pill Design) -->
<nav class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile Navigation">
  <div class="bottom-notch-bg">
    <svg viewBox="0 0 360 64" fill="none" preserveAspectRatio="none" class="notch-svg-shape">
      <path
        d="M 32 0 L 136 0 C 148 0, 154 12, 160 22 C 166 34, 172 38, 180 38 C 188 38, 194 34, 200 22 C 206 12, 212 0, 224 0 L 328 0 A 32 32 0 0 1 360 32 A 32 32 0 0 1 328 64 L 32 64 A 32 32 0 0 1 0 32 A 32 32 0 0 1 32 0 Z"
        fill="rgba(16, 16, 16, 0.95)"
        stroke="rgba(255, 255, 255, 0.14)"
        stroke-width="1.2"
      />
    </svg>
  </div>

  <div class="bottom-nav-grid">
    <!-- 1. Home -->
    <a href="/#hero" class="bot-nav-item active" data-id="hero" aria-label="Home">
      <div class="bot-nav-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <span class="bot-dot"></span>
    </a>

    <!-- 2. About -->
    <a href="/#about" class="bot-nav-item" data-id="about" aria-label="About">
      <div class="bot-nav-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <span class="bot-dot"></span>
    </a>

    <!-- 3. Center Elevated Button: Portfolio (Projects) -->
    <a href="/#projects" class="bot-nav-item bot-nav-center" data-id="projects" data-tab="proyek" aria-label="Portfolio">
      <div class="center-circle-btn">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
      </div>
      <span class="bot-dot center-dot"></span>
    </a>

    <!-- 4. Sertifikasi -->
    <a href="/#projects" class="bot-nav-item" data-id="sertifikasi" data-tab="sertifikasi" aria-label="Sertifikasi">
      <div class="bot-nav-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="6"/>
          <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
        </svg>
      </div>
      <span class="bot-dot"></span>
    </a>

    <!-- 5. Contact -->
    <a href="/#contact" class="bot-nav-item" data-id="contact" aria-label="Contact">
      <div class="bot-nav-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <span class="bot-dot"></span>
    </a>
  </div>
</nav>

<script>
  const desktopLinks = document.querySelectorAll('#navLinks a');
  const mobileLinks = document.querySelectorAll('.bot-nav-item');

  function setActive(id) {
    desktopLinks.forEach((a) => {
      a.classList.toggle('active', a.getAttribute('data-id') === id);
    });

    mobileLinks.forEach((item) => {
      const itemId = item.getAttribute('data-id');
      if (id === 'projects') {
        const certTab = document.querySelector('.tab-btn[data-tab="sertifikasi"]');
        const isCertActive = certTab?.classList.contains('active');
        if (isCertActive) {
          item.classList.toggle('active', itemId === 'sertifikasi');
        } else {
          item.classList.toggle('active', itemId === 'projects');
        }
      } else {
        item.classList.toggle('active', itemId === id);
      }
    });
  }

  // Handle mobile bottom nav clicks
  mobileLinks.forEach((item) => {
    item.addEventListener('click', (e) => {
      const id = item.getAttribute('data-id');
      const tab = item.getAttribute('data-tab');

      if (tab) {
        const targetTabBtn = document.querySelector(`.tab-btn[data-tab="${tab}"]`);
        if (targetTabBtn instanceof HTMLElement) {
          targetTabBtn.click();
        }
      }

      setActive(id);
    });
  });

  // Listen to tab changes in Showcase to sync bottom nav
  const tabButtons = document.querySelectorAll('.tab-btn');
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab === 'sertifikasi') {
        mobileLinks.forEach((item) => item.classList.toggle('active', item.getAttribute('data-id') === 'sertifikasi'));
      } else if (tab === 'proyek' || tab === 'stack') {
        const projectsEl = document.getElementById('projects');
        const rect = projectsEl?.getBoundingClientRect();
        if (rect && rect.top <= window.innerHeight * 0.6 && rect.bottom >= window.innerHeight * 0.2) {
          mobileLinks.forEach((item) => item.classList.toggle('active', item.getAttribute('data-id') === 'projects'));
        }
      }
    });
  });

  const sections = ['hero', 'about', 'projects', 'contact']
    .map((id) => document.getElementById(id))
    .filter(Boolean);

  if (sections.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );

    sections.forEach((s) => io.observe(s));
  }

  // Navbar background blur when scrolled past hero (Desktop top header)
  const navwrap = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navwrap?.classList.add('scrolled');
    } else {
      navwrap?.classList.remove('scrolled');
    }
  }, { passive: true });
</script>
