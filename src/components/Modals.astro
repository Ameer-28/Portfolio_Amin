<!-- MODAL: Certificate photo -->
<div class="modal-overlay" id="certModal">
  <div class="modal-box" style="max-width:560px;">
    <div class="modal-media" id="certModalMedia">
      <button class="modal-close" data-close>&times;</button>
    </div>
    <div class="modal-body" id="certModalBody"></div>
  </div>
</div>

<script>
  const certModal = document.getElementById('certModal');
  const certModalMedia = document.getElementById('certModalMedia');
  const certModalBody = document.getElementById('certModalBody');

  window.addEventListener('open-cert-modal', (e) => {
    const c = e.detail;
    if (!certModalMedia || !certModalBody || !certModal) return;

    certModalMedia.innerHTML = `
      <button class="modal-close" data-close>&times;</button>
      <img src="${c.img}" alt="${c.name}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div class="thumb-fallback" style="display:none;">${c.initials}</div>
    `;

    certModalBody.innerHTML = '';

    certModal.classList.add('show');
    document.body.style.overflow = 'hidden';
  });

  function closeModals() {
    certModal?.classList.remove('show');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof Element && (target.matches('[data-close]') || target.classList.contains('modal-overlay'))) {
      closeModals();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModals();
  });
</script>
