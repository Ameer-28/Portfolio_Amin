<script>
  const selectors = [
    '.about-eyebrow',
    '.about h2',
    '.about-columns p',
    '.showcase-head',
    '.tabs',
    '.project-grid .project-card',
    '.cert-list .cert-card',
    '.stack-icon',
    '.email-card',
    '.social-tile'
  ];

  const targets = Array.from(document.querySelectorAll(selectors.join(',')));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (targets.length && !prefersReducedMotion) {
    const parentCounters = new Map();

    targets.forEach((el) => {
      const parent = el.parentElement;
      const count = parentCounters.get(parent) || 0;
      parentCounters.set(parent, count + 1);
      const delay = Math.min(count * 90, 360);

      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
      el.style.transition = `opacity .7s cubic-bezier(.4,0,.2,1) ${delay}ms, transform .7s cubic-bezier(.4,0,.2,1) ${delay}ms`;
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;

          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';

          const clear = (e) => {
            if (e.target !== el) return;
            el.style.transition = '';
            el.style.opacity = '';
            el.style.transform = '';
            el.removeEventListener('transitionend', clear);
          };
          el.addEventListener('transitionend', clear);

          io.unobserve(el);
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    targets.forEach((el) => io.observe(el));
  }
</script>