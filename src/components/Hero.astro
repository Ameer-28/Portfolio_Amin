---
<section class="hero-showcase hero-animate" id="hero">
  <div class="hero-canvas">

    <!-- LAYER 1: Solid white text BEHIND person -->
    <div class="hero-text-layer text-behind" aria-hidden="true">
      <div class="hero-word word-software">Software</div>
      <div class="hero-word word-engineer">Engineer</div>
    </div>

    <!-- LAYER 2: Cutout photo in the MIDDLE -->
    <div class="hero-portrait-wrap">
      <img
        src="/images/hero-person.png"
        alt="Muhammad Amin Murtadho"
        class="hero-portrait-img"
        loading="eager"
      />
    </div>

    <!-- LAYER 3: Outlined text IN FRONT of person -->
    <h1 class="hero-text-layer text-front">
      <div class="hero-word word-software">Software</div>
      <div class="hero-word word-engineer">Engineer</div>
    </h1>

  </div>
</section>

<script>
  // Re-trigger hero reveal animation when clicking Home
  const homeLinks = document.querySelectorAll('a[href="#hero"]');
  const hero = document.getElementById('hero');

  if (homeLinks.length && hero) {
    homeLinks.forEach((link) => {
      link.addEventListener('click', () => {
        hero.classList.remove('hero-animate');
        void hero.offsetWidth;
        hero.classList.add('hero-animate');
      });
    });
  }
</script>
