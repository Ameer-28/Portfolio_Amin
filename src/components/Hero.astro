---
import HeroTitle from './react/HeroTitle.jsx';
---
<section class="hero" id="hero">
  <div class="hero-grid">
    <div>
      <div class="kicker">
        <span class="dot"></span>
        Terbuka untuk magang &amp; kolaborasi
      </div>

      <HeroTitle client:load />

      <p class="sub">Hi, I'm <b>Muhammad Amin Murtadho</b>. A Software Engineering (RPL) student who enjoys turning ideas into clean, well-structured, and dependable backend systems.</p>

      <div class="actions">
        <a href="#projects" class="btn-primary">View Projects ➝</a>
        <a href="/CV%20Muhammad%20AMin%20Murtadho.pdf" download="CV-Muhammad-Amin-Murtadho.pdf" class="btn-ghost">Download CV</a>
      </div>
    </div>

    <div class="photo-stage">
      <div class="photo-card" id="photoCard">
        <div class="photo-frame">
          <img src="/images/profil.jpeg" alt="Muhammad Amin Murtadho"  />
        </div>
        <div class="photo-glow" id="photoGlow"></div>

        <div class="float-chip chip-1">⌘ TypeScript</div>
        <div class="float-chip chip-2">{ } Nest.js</div>

        <div class="photo-tag">
          <div>
            <div class="name">Amin Murtadho</div>
            <div class="role">Backend Developer</div>
          </div>
          <div class="status-chip"><span></span>Open</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const card = document.getElementById('photoCard');
  const glow = document.getElementById('photoGlow');
  const maxTilt = 10;

  if (card && glow) {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      const rotY = (x - 0.5) * maxTilt * 2;
      const rotX = (0.5 - y) * maxTilt * 2;
      card.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      glow.style.setProperty('--mx', `${x * 100}%`);
      glow.style.setProperty('--my', `${y * 100}%`);
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
  }
</script>
